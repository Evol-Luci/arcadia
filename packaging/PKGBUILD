# Maintainer: Arcadia Project <luci.evol.icul@gmail.com>
pkgname=arcadia
pkgver=0.1.0
pkgrel=1
pkgdesc="Linux-native emulation ecosystem (discovers and resumes emulator state)"
arch=('x86_64')
url="https://github.com/Evol-Luci/arcadia"
license=('GPL-3.0-or-later')
depends=('webkit2gtk-4.1' 'gtk3')
makedepends=('rust' 'cargo' 'npm' 'nodejs')
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::https://github.com/Evol-Luci/arcadia/archive/refs/tags/v$pkgver.tar.gz")
# Replace with the real digest after the release is published: updpkgsums
sha256sums=('SKIP')

build() {
  cd "$srcdir/$pkgname-$pkgver/desktop"
  npm ci
  # `-b none` builds the frontend + Rust binary and renames it to the product
  # name (arcadia), but skips Tauri's own deb/rpm/appimage bundling.
  npm run tauri -- build -b none
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -Dm755 target/release/arcadia "$pkgdir/usr/bin/arcadia"

  install -Dm644 packaging/arcadia.desktop \
    "$pkgdir/usr/share/applications/arcadia.desktop"
  install -Dm644 packaging/org.arcadia.dreamshell.metainfo.xml \
    "$pkgdir/usr/share/metainfo/org.arcadia.dreamshell.metainfo.xml"

  install -Dm644 desktop/src-tauri/icons/32x32.png \
    "$pkgdir/usr/share/icons/hicolor/32x32/apps/arcadia.png"
  install -Dm644 desktop/src-tauri/icons/128x128.png \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/arcadia.png"
  install -Dm644 desktop/src-tauri/icons/128x128@2x.png \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/arcadia.png"
  install -Dm644 desktop/src-tauri/icons/icon.png \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/arcadia.png"
}
